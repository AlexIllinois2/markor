+     */
+    @NonNull
+    public List<String> relocateNotebookScopedFiles(@Nullable final File previousNotebook) {
+        final File notebook = getNotebookDirectory();
+        final String todoName = rstr(R.string.todo_default_filename);
+        final String quickName = rstr(R.string.quicknote_default_filename);
+        final List<String> fallback = new ArrayList<>();
+        final File todo = getTodoFile();
+        if (!isInsideNotebook(todo)) {
+            final File moved = mapIntoNotebook(todo, previousNotebook, notebook);
+            final boolean kept = moved != null && moved.isFile();
+            setTodoFile(kept ? moved : new File(notebook, todoName));
+            if (!kept) {
+                fallback.add(todoName);
+            }
+        }
+        final File quick = getQuickNoteFile();
+        if (!isInsideNotebook(quick)) {
+            final File moved = mapIntoNotebook(quick, previousNotebook, notebook);
+            final boolean kept = moved != null && moved.isFile();
+            setQuickNoteFile(kept ? moved : new File(notebook, quickName));
+            if (!kept) {
+                fallback.add(quickName);
+            }
+        }

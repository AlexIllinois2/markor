+                                 @NonNull final File notebook) {
+        if (previousNotebook == null) {
+            return null;
+        }
+        final String previous = canonicalPath(previousNotebook);
+        final String path = canonicalPath(file);
+        return previous.length() > 0 && path.startsWith(previous + File.separator)
+                ? new File(notebook, path.substring(previous.length() + 1)) : null;
+    }

+    //########################
+    //## SQLite 笔记本 (打开/转换/解锁)
+    //########################
+
+    /** 转换任务体；允许抛受检异常，由 runSqliteConvertAsync 统一转成 Toast */
+    private interface SqliteTask {
+        void run() throws Exception;
+    }
+
+    /** 在后台线程执行转换任务, 完成或失败时用 Toast 提示 */
+    private static void runSqliteConvertAsync(final Activity activity, final SqliteTask task) {
+        new Thread(() -> {
+            try {
+                task.run();
+                activity.runOnUiThread(() ->
+                        Toast.makeText(activity, R.string.sqlite_convert_done, Toast.LENGTH_LONG).show());
+            } catch (Exception e) {
+                final String detail = e.getMessage() != null ? e.getMessage() : e.toString();
+                activity.runOnUiThread(() -> Toast.makeText(activity,
+                        activity.getString(R.string.sqlite_convert_failed, detail), Toast.LENGTH_LONG).show());
+            }
+        }, "sqlite_convert").start();
+    }
+
+    /** 密码输入对话框 (掩码显示)。allowEmpty 时空输入也会回调空字符串 */
+    private static void showSqlitePasswordDialog(final Activity activity, final int titleRes,
+            final CharSequence message, final boolean allowEmpty, final GsCallback.a1<String> callback) {
+        final DialogOptions dopt = baseConf(activity);
+        dopt.isSearchEnabled = true;
+        dopt.titleText = titleRes;
+        dopt.messageText = message;
+        dopt.searchHintText = R.string.file_encryption_password;
+        dopt.searchInputType = InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD;
+        dopt.selectionMode = DialogOptions.SelectionMode.NONE;
+        dopt.callback = password -> {
+            if (allowEmpty || !TextUtils.isEmpty(password)) {
+                callback.callback(password == null ? "" : password);
+            }
+        };
+        GsSearchOrCustomTextDialog.showMultiChoiceDialogWithSearchFilterUI(activity, dopt);
+    }
+
+    /**
+     * 校验并激活 SQLite 笔记本:
+     * 已记住的派生密钥可用 → 直接激活; 需要密码/密码错 → 弹窗重输;
+     * 不是笔记本库或旧版格式 → 报错且不占用笔记本位置。
+     */
+    public static void tryActivateSqliteNotebook(final Activity activity, final File dbFile,
+            @Nullable final GsCallback.a1<Boolean> onDone) {
+        activateSqliteNotebook(activity, dbFile, null, onDone);
+    }
+
+    private static void activateSqliteNotebook(final Activity activity, final File dbFile,
+            @Nullable final char[] password, @Nullable final GsCallback.a1<Boolean> onDone) {
+        SqliteNotebook.open(activity, dbFile, password, result -> {
+            switch (result) {
+                case OK: {
+                    final AppSettings as = AppSettings.get(activity);
+                    final File previousNotebook = as.getNotebookDirectory();
+                    as.setSqliteNotebookFile(dbFile);
+                    as.setRecreateMainRequired(true);
+                    relocateNotebookScopedFiles(activity, previousNotebook);
+                    if (onDone != null) {
+                        onDone.callback(true);
+                    }
+                    return;
+                }
+                case PASSWORD_REQUIRED: {
+                    promptSqliteNotebookPassword(activity, dbFile, false, onDone);
+                    return;
+                }
+                case WRONG_PASSWORD: {
+                    promptSqliteNotebookPassword(activity, dbFile, true, onDone);
+                    return;
+                }
+                case NOT_NOTEBOOK_DB: {
+                    showToast(activity, activity.getString(R.string.sqlite_notebook_not_a_notebook));
+                    if (onDone != null) {
+                        onDone.callback(false);
+                    }
+                    return;
+                }
+                case LEGACY_DB: {
+                    showConfirmDialog(activity, R.string.sqlite_menu,
+                            activity.getString(R.string.sqlite_notebook_legacy_db), null, null);
+                    if (onDone != null) {
+                        onDone.callback(false);
+                    }
+                    return;
+                }
+                default: {
+                    showToast(activity, activity.getString(R.string.sqlite_notebook_open_failed));
+                    if (onDone != null) {
+                        onDone.callback(false);
+                    }
+                }
+            }
+        });
+    }
+
+    private static void showToast(final Activity activity, final String text) {
+        activity.runOnUiThread(() -> Toast.makeText(activity, text, Toast.LENGTH_LONG).show());
+    }
+
+    /**
+     * 笔记本换了根目录（切文件夹 / 切 db / 停用 db）之后，把 ToDo 与 QuickNote 收回新笔记本内。
+     * 没能跟着过来的（新笔记本里没有同名相对路径的）会退回笔记本内的默认文件，需要告知用户重选。
+     */
+    private static void relocateNotebookScopedFiles(final Activity activity,
+                                                    @Nullable final File previousNotebook) {
+        final List<String> fallback = AppSettings.get(activity).relocateNotebookScopedFiles(previousNotebook);
+        if (!fallback.isEmpty()) {
+            showToast(activity, activity.getString(R.string.todo_quicknote_reset_after_switch,
+                    TextUtils.join(", ", fallback)));
+        }
+    }
+
+    private static void promptSqliteNotebookPassword(final Activity activity, final File dbFile,
+            final boolean wasError, @Nullable final GsCallback.a1<Boolean> onDone) {
+        String msg = activity.getString(R.string.sqlite_notebook_open_file, dbFile.getAbsolutePath());
+        if (wasError) {
+            msg = activity.getString(R.string.sqlite_notebook_invalid_password) + "\n" + msg;
+        }
+        showSqlitePasswordDialog(activity, R.string.sqlite_notebook_password, msg, false,
+                password -> activateSqliteNotebook(activity, dbFile, password.toCharArray(), onDone));
+    }
+
+    /** "打开文件夹 / 打开 SQLite db" 选择对话框 */
+    public static void showOpenNotebookDialog(final Activity activity) {
+        final DialogOptions dopt = baseConf(activity);
+        final List<String> data = new ArrayList<>();
+        data.add(activity.getString(R.string.sqlite_open_folder));
+        data.add(activity.getString(R.string.sqlite_open_db));
+        dopt.data = data;

+        GsSearchOrCustomTextDialog.showMultiChoiceDialogWithSearchFilterUI(activity, dopt);
+    }
+
+    /** 打开普通文件夹作为笔记本 (停用 sqlite 模式) */
+    public static void pickNotebookFolder(final Activity activity) {
+        final AppSettings as = AppSettings.get(activity);
+        MarkorFileBrowserFactory.showFolderDialog(new GsFileBrowserOptions.SelectionListenerAdapter() {
+            @Override
+            public void onFsViewerSelected(String request, File file, final Integer lineNumber) {
+                final File previousNotebook = as.getNotebookDirectory();
+                as.setSqliteNotebookFile(null);
+                SqliteNotebook.deactivate();
+                as.setNotebookDirectory(file);
+                as.setRecreateMainRequired(true);
+                relocateNotebookScopedFiles(activity, previousNotebook);
+            }
+
+            @Override
+            public void onFsViewerConfig(GsFileBrowserOptions.Options dopt) {
+                dopt.titleText = R.string.select_storage_folder;
+                final File db = as.getSqliteNotebookFile();
+                dopt.rootFolder = db != null && db.getParentFile() != null
+                        ? db.getParentFile() : as.getNotebookDirectory();
+            }
+        }, ((AppCompatActivity) activity).getSupportFragmentManager(), activity);
+    }
+
+    /** 选择 SQLite db 文件作为笔记本打开 */
+    public static void pickSqliteNotebookDb(final Activity activity) {
+        final AppSettings as = AppSettings.get(activity);
+        MarkorFileBrowserFactory.showFileDialog(new GsFileBrowserOptions.SelectionListenerAdapter() {
+            @Override
+            public void onFsViewerSelected(String request, File file, final Integer lineNumber) {
+                tryActivateSqliteNotebook(activity, file, null);
+            }
+
+            @Override
+            public void onFsViewerConfig(GsFileBrowserOptions.Options dopt) {
+                dopt.titleText = R.string.sqlite_open_db;
+                final File db = as.getSqliteNotebookFile();
+                dopt.rootFolder = db != null && db.getParentFile() != null
+                        ? db.getParentFile() : as.getNotebookDirectory();
+                dopt.newDirButtonEnable = false;
+            }
+        }, ((AppCompatActivity) activity).getSupportFragmentManager(), activity,
+                (context, file) -> file.isDirectory() || SqliteNotebookUtils.isSqliteNotebookFile(file));
+    }
+
+    /** 按文件类型列出可用的 SQLite 转换操作 */
+    public static void showSqliteConvertDialog(final Activity activity, final File file) {
+        final boolean isDir = file.isDirectory();
+        final boolean isDb = SqliteNotebookUtils.isSqliteNotebookFile(file);
+        final boolean isZip = SqliteNotebookUtils.isZipFile(file);
+        if ((!isDir && !isDb && !isZip) || file.getParentFile() == null) {
+            Toast.makeText(activity, R.string.sqlite_convert_unsupported, Toast.LENGTH_SHORT).show();
+            return;
+        }
+
+        final DialogOptions dopt = baseConf(activity);
+        final List<String> data = new ArrayList<>();
+        final List<Runnable> actions = new ArrayList<>();
+
+        if (isDir) {
+            data.add(activity.getString(R.string.sqlite_export_to_db));
+            actions.add(() -> convertFolderToDb(activity, file));
+        }
+        if (isZip) {
+            data.add(activity.getString(R.string.sqlite_convert_zip_to_db));
+            actions.add(() -> convertZipToDb(activity, file));
+        }
+        if (isDb) {
+            data.add(activity.getString(R.string.sqlite_extract_to_folder));
+            actions.add(() -> convertDbToFolder(activity, file));
+            data.add(activity.getString(R.string.sqlite_export_to_zip));
+            actions.add(() -> convertDbToZip(activity, file));
+        }
+
+        dopt.data = data;
+        dopt.isSearchEnabled = false;
+        dopt.titleText = R.string.sqlite_menu;
+        dopt.messageText = file.getAbsolutePath();
+        dopt.positionCallback = positions -> actions.get(positions.get(0)).run();
+        GsSearchOrCustomTextDialog.showMultiChoiceDialogWithSearchFilterUI(activity, dopt);
+    }
+
+    private static String stripSqliteExtension(final String name) {
+        return name.replaceFirst("(?i)\\.(db|sqlite|sqlite3|vsdb)$", "");
+    }
+
+    private static void convertFolderToDb(final Activity activity, final File srcDir) {
+        final File dest = new File(srcDir.getParentFile(), srcDir.getName() + ".db");
+        askSqliteOverwriteThen(activity, dest, () ->
+                showSqlitePasswordDialog(activity, R.string.sqlite_export_to_db,
+                        activity.getString(R.string.sqlite_password_empty_means_plain, dest.getAbsolutePath()),
+                        true, password -> runSqliteConvertAsync(activity, () ->
+                                SqliteNotebookUtils.exportFolderToDb(srcDir, dest, password.toCharArray()))));
+    }
+
+    private static void convertZipToDb(final Activity activity, final File zipFile) {
+        final File dest = new File(zipFile.getParentFile(),
+                stripSqliteExtension(zipFile.getName()) + ".db");
+        askSqliteOverwriteThen(activity, dest, () ->
+                showSqlitePasswordDialog(activity, R.string.sqlite_convert_zip_to_db,
+                        activity.getString(R.string.sqlite_password_empty_means_plain, dest.getAbsolutePath()),
+                        true, password -> runSqliteConvertAsync(activity, () ->
+                                SqliteNotebookUtils.importZipToDb(activity, zipFile, dest, password.toCharArray()))));
+    }

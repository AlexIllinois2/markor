<resources xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="AppTheme.Unified.StartupFlash" parent="AppTheme.Unified">
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- 基类换成 Material 3：组件（导航栏、弹窗、菜单、FAB、输入框）直接吃 M3 的
         形状/色调/动效；颜色角色在下面全部指向本应用自己的"墨色 + 中性灰"，
         避免回落到 M3 默认的紫色方案。 -->
    <style name="AppTheme.Unified" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- M3 颜色角色 -->
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/m3_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorOnBackground">@color/m3_on_surface</item>
        <item name="colorSurfaceInverse">@color/m3_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/m3_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/m3_inverse_primary</item>
        <item name="colorControlHighlight">@color/accent_soft</item>

        <!-- 工具栏上下文改成浅色表面：返回箭头等图标按 ?attr/colorControlNormal 着色，
             默认的 DarkActionBar 上下文会让它们在浅色标题栏上变成白色看不见 -->
        <item name="actionBarTheme">@style/MarkorToolbarOverlay</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBarOverlay">true</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:actionButtonStyle">@style/LessSpaceActionButtonStyle</item>
        <item name="preferenceTheme">@style/AppTheme.PreferenceTheme</item>
        <item name="dialogTheme">@style/Theme.AppCompat.DayNight.Dialog.Rounded</item>
        <item name="alertDialogTheme">@style/Theme.AppCompat.DayNight.Dialog.Rounded</item>
        <item name="actionOverflowMenuStyle">@style/MarkorOverflowMenu</item>
        <item name="android:actionOverflowMenuStyle" tools:targetApi="lollipop">@style/MarkorOverflowMenu</item>
        <item name="colorPrimaryDark">@color/card</item>
        <item name="android:actionModeBackground">@color/card</item>
        <item name="actionModeBackground">@color/card</item>
        <item name="actionModeStyle">@style/MarkorActionMode</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlNormal">@color/primary_text</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="dialogCornerRadius">@dimen/dialog_corner_radius</item>

        <!-- Android V21 options; ignore IDE warnings -->
        <item name="android:windowContentTransitions" tools:targetApi="lollipop">true</item>
        <item name="android:windowAllowEnterTransitionOverlap" tools:targetApi="lollipop">true</item>
        <item name="android:windowAllowReturnTransitionOverlap" tools:targetApi="lollipop">true</item>
        <item name="android:windowSharedElementEnterTransition" tools:targetApi="lollipop">@android:transition/move</item>
        <item name="android:windowSharedElementExitTransition" tools:targetApi="lollipop">@android:transition/move</item>
        <item name="android:statusBarColor" tools:targetApi="lollipop">@color/card</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@color/background</item>

        <!-- System bar icons follow the surface: dark on the light app bar, light at night -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/markor_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/markor_light_system_bars</item>

        <!-- Android V28 options; ignore IDE warnings -->
        <item name="android:dialogCornerRadius" tools:targetApi="p">@dimen/dialog_corner_radius</item>

        <!-- android-35 Disable window size overlap -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="AppTheme.PreferenceTheme" parent="PreferenceThemeOverlay.v14.Material">
        <item name="preferenceCategoryStyle">@style/AppTheme.PreferenceTheme.CategoryStyle</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
    </style>

    <style name="AppTheme.PreferenceTheme.CategoryStyle" parent="Preference.Category">
        <item name="android:layout">@layout/opoc_pref_category_text</item>
    </style>

    <!-- App bar overlay: surface coloured bar, so all toolbar content uses the ink colour -->
    <style name="MarkorToolbarOverlay" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:actionModeBackground">@color/card</item>
        <item name="actionModeBackground">@color/card</item>

        <!-- 右上角 ⋮ 弹出的菜单：默认是方角白块，跟应用的圆角对不上 -->
        <item name="actionOverflowMenuStyle">@style/MarkorOverflowMenu</item>
        <item name="android:actionOverflowMenuStyle">@style/MarkorOverflowMenu</item>

        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:actionMenuTextColor">@color/primary_text</item>
        <item name="actionMenuTextColor">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="colorControlNormal">@color/primary_text</item>
    </style>

    <!-- 圆角弹出菜单：留给工具栏右上角的 ⋮ 用 -->
    <style name="MarkorOverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">0dp</item>
        <item name="android:overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
    </style>

    <!-- Kept for backwards compatibility with existing layout references -->
    <style name="LightTextToolbarOverlay" parent="MarkorToolbarOverlay" />

    <style name="AppTheme.Light.AppBarOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Contextual action mode: same surface as the app bar instead of a dark ink block -->
    <style name="MarkorActionMode" parent="Widget.AppCompat.ActionMode">
        <item name="background">@color/card</item>
        <item name="titleTextStyle">@style/MarkorActionModeTitle</item>
        <item name="subtitleTextStyle">@style/MarkorActionModeSubtitle</item>
        <item name="actionMenuTextColor">@color/primary_text</item>
    </style>

    <style name="MarkorActionModeTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="MarkorActionModeSubtitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="android:textColor">@color/secondary_text</item>
    </style>

    <!-- App bar typography: Expressive 的标题更大更实，层级一眼能看出来 -->
    <style name="MarkorToolbarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">21sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Pill / circle shaped floating action buttons -->
    <style name="MarkorFabShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- M3 底部导航的选中指示器：比默认再宽一点、圆角大一点（Expressive 的手感），
         颜色用 secondaryContainer 那档中性色，不带色相 -->
    <style name="MarkorNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">58dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="android:color">@color/m3_secondary_container</item>
        <item name="shapeAppearance">@style/MarkorNavIndicatorShape</item>
    </style>

    <style name="MarkorNavIndicatorShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Rounded overflow menu on the same surface as the app bar -->
    <style name="MarkorPopupMenu" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:colorBackground">@color/card</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- reduced spacing -->
    <style name="LessSpaceActionButtonStyle" parent="Widget.AppCompat.ActionButton">
        <item name="android:minWidth">1dip</item>
        <item name="android:paddingLeft">8dip</item>
        <item name="android:paddingRight">8dip</item>
        <item name="android:paddingStart">8dip</item>
        <item name="android:paddingEnd">8dip</item>
    </style>

    <style name="Theme.AppCompat.DayNight.Dialog.Rounded" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="dialogCornerRadius">@dimen/dialog_corner_radius</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowBackground">@drawable/rounded_corner_background</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <!-- 复选框/单选等控件轮廓：纯黑或纯白都太冲，用图标用的那档中性色 -->
        <item name="colorControlNormal">@color/pref_icon</item>
        <!-- 对话框里不应出现三颗一样红的按钮；颜色只留给"哪一行被选中"这类数据信号 -->
        <item name="colorAccent">@color/primary_text</item>
        <item name="buttonBarPositiveButtonStyle">@style/MarkorDialogButton.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/MarkorDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/MarkorDialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle" tools:targetApi="lollipop">@style/MarkorDialogButton.Primary</item>
        <item name="android:buttonBarNegativeButtonStyle" tools:targetApi="lollipop">@style/MarkorDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle" tools:targetApi="lollipop">@style/MarkorDialogButton</item>
    </style>

    <!-- 对话框按钮文字不抢戏：次要动作走次级灰，主动作才用墨色加粗 -->
    <style name="MarkorDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="MarkorDialogButton.Primary">
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>

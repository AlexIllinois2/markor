<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:theme="@style/AppTheme.Unified"
    tools:context="net.gsantner.markor.activity.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_header_rounded"
        android:elevation="0dp"
        android:theme="@style/AppTheme.Light.AppBarOverlay"
        app:elevation="0dp">

        <!-- 同一格里叠两套头部：常驻的是搜索行，选中条目后才换成工具栏（目录名 + 选择计数 + 动作） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                android:theme="@style/LightTextToolbarOverlay"
                app:contentInsetStart="@dimen/card_margin_horizontal"
                app:popupTheme="@style/MarkorPopupMenu"
                app:subtitleTextColor="@color/secondary_text"
                app:titleTextAppearance="@style/MarkorToolbarTitle">

            </androidx.appcompat.widget.Toolbar>

            <LinearLayout
                android:id="@+id/file_header"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/card_margin_horizontal"
                android:paddingLeft="@dimen/card_margin_horizontal"
                android:paddingEnd="8dp"
                android:paddingRight="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/file_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="10dp"
                    android:layout_marginRight="10dp"
                    android:maxWidth="112dp"
                    android:singleLine="true"
                    android:textColor="@color/primary_text"
                    android:textSize="17sp"
                    android:visibility="gone"
                    tools:text="产品笔记"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/file_search_box"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingLeft="12dp"
                    android:paddingEnd="4dp"
                    android:paddingRight="4dp">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search_black_24dp"
                        android:tint="@color/secondary_text" />

                    <EditText
                        android:id="@+id/file_search_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:singleLine="true"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/secondary_text"
                        android:textSize="14sp"
                        tools:ignore="Autofill,TextFields" />

                    <ImageButton
                        android:id="@+id/file_search_clear"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/close"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/baseline_close_24"
                        android:tint="@color/secondary_text"
                        android:visibility="gone" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/file_sort"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sort_by"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sort_black_24dp"
                    android:tint="@color/primary_text" />

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/main__view_pager_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_marginBottom="@dimen/bottom_nav_space" />

    <!--suppress AndroidUnknownAttribute -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_new_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="104dp"
        android:contentDescription="@string/create_new_file_or_folder"
        android:src="@drawable/ic_add_white_24dp"
        app:backgroundTint="@color/fab_bg"
        app:elevation="6dp"
        app:fabCustomSize="60dp"
        app:maxImageSize="26dp"
        app:rippleColor="@color/fab_ripple"
        app:shapeAppearanceOverlay="@style/MarkorFabShape"
        app:tint="@color/fab_ink" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="@dimen/bottom_nav_margin_horizontal"
        android:layout_marginEnd="@dimen/bottom_nav_margin_horizontal"
        android:layout_marginBottom="@dimen/bottom_nav_margin_bottom"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="10dp"
        app:elevation="10dp"
        app:itemActiveIndicatorStyle="@style/MarkorNavIndicator"
        app:itemIconSize="23dp"
        app:itemIconTint="@drawable/bottomnav_icon_selector"
        app:itemTextColor="@drawable/bottomnav_text_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main__bottom_nav" />

</FrameLayout>

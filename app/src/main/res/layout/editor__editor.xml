<?xml version="1.0" encoding="utf-8"?>
<!-- 编辑页：只有一个纯文本编辑区，不放文件列表/加号一类的东西 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 当前标签的 DocumentEditAndViewFragment 放在这里 -->
    <FrameLayout
        android:id="@+id/editor__content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 没有打开任何文件时的空态 -->
    <LinearLayout
        android:id="@+id/editor__empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_no_open_file"
            android:textColor="@color/primary_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/editor_no_open_file_hint"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 列表里的一行标签：未保存圆点 + 文件名 + 固定 + 关闭 + 拖动手柄
     52dp 的高度是量着手柄定的：手指要能稳稳压在手柄上拖，44dp 太窄容易滑出去 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/bg_editor_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <View
        android:id="@+id/editor__row_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/bg_tab_dot"
        android:visibility="gone" />

    <TextView
        android:id="@+id/editor__row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/primary_text"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/editor__row_pin"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="9dp"
        android:src="@drawable/ic_star_border_black_24dp"
        android:tint="@color/secondary_text" />

    <ImageView
        android:id="@+id/editor__row_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="9dp"
        android:src="@drawable/baseline_close_24"
        android:tint="@color/secondary_text" />

    <ImageView
        android:id="@+id/editor__row_drag"
        android:layout_width="38dp"
        android:layout_height="52dp"
        android:contentDescription="@string/editor_drag_to_reorder"
        android:paddingLeft="11dp"
        android:paddingTop="14dp"
        android:paddingRight="11dp"
        android:paddingBottom="14dp"
        android:src="@drawable/ic_drag_handle_black_24dp"
        android:tint="@color/secondary_text" />
</LinearLayout>

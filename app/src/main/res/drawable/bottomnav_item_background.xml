<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral pill behind the active bottom navigation item: the chrome holds no hue -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item
                android:bottom="4dp"
                android:left="6dp"
                android:right="6dp"
                android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nav_pill" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:bottom="4dp"
                android:left="6dp"
                android:right="6dp"
                android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nav_pill" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>

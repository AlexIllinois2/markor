<!-- 文件页工具栏只保留"选中条目之后才有意义"的动作。
     常驻入口是顶部那一行里的搜索框和排序按钮，所以 go-to / import / git / 全选
     以及 ⋮ 里的那些条目整包去掉了；排序与搜索保留成隐藏条目，只给自定义控件转发用。 -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="AlwaysShowAction">

    <item
        android:id="@+id/action_favourite"
        android:icon="@drawable/ic_star_border_black_24dp"
        android:title="@string/favourite"
        android:visible="false"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_favourite_remove"
        android:icon="@drawable/ic_star_black_24dp"
        android:title="@string/favourite"
        android:visible="false"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_rename_selected_item"
        android:icon="@drawable/ic_gs_rename_black_24dp"
        android:title="@string/rename"
        android:visible="false"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_info_selected_item"
        android:icon="@drawable/ic_info_black_24dp"
        android:title="@string/details"
        android:visible="false"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_delete_selected_items"
        android:icon="@drawable/ic_delete_black_24dp"
        android:title="@string/delete"
        android:visible="false"
        app:showAsAction="always" />

    <!-- 由顶部搜索框右侧的排序按钮转发到这里 -->
    <item
        android:id="@+id/action_sort"
        android:icon="@drawable/ic_sort_black_24dp"
        android:title="@string/sort_by"
        android:visible="false"
        app:showAsAction="never" />
    <!-- 搜索框已经是常驻控件，这个条目只用于"回车走全局搜索"的转发 -->
    <item
        android:id="@+id/action_search"
        android:icon="@drawable/ic_search_black_24dp"
        android:title="@string/search"
        android:visible="false"
        app:showAsAction="never" />

</menu>
